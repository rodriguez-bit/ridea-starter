# Skopiruj do .dev.vars (lokalny vyvoj) a doplni vlastne hodnoty.
# .dev.vars je v .gitignore - NIKDY ho necommituj.
# Na produkcii sa to iste nastavuje cez: npx wrangler secret put NAZOV

# Povinne
JWT_SECRET="vygeneruj-nahodny-retazec-min-32-znakov"
ANTHROPIC_API_KEY="sk-ant-..."

# Aspon jeden STT provider (ak das oba, ElevenLabs je primarny a Whisper fallback)
ELEVENLABS_API_KEY="sk_..."
OPENAI_API_KEY="sk-..."

# Jednorazovy token na vytvorenie prveho admina (POST /api/bootstrap)
BOOTSTRAP_TOKEN="nahodny-retazec-ktory-po-setupe-zmazes"

# Volitelne
CLAUDE_MODEL="claude-haiku-4-5"
# Denny strop vydavkov na prepis a analyzu v EUR (default 2).
# 30 nahravok po 2 minutach denne stoji zhruba 0,50 EUR, takze 2 EUR je ~4x rezerva.
DAILY_SPEND_LIMIT_EUR="2"
STT_DISABLED=""
